# Copy this file to ".env" to customize local settings for docker-compose.
# See DOCKER.md for details.

# Comma-separated list of origins allowed by the backend's CORS policy.
# Always keep http://localhost:5173 in the list if you also use the app
# from the same machine that runs Docker.
ALLOWED_ORIGINS=http://localhost:5173,http://<seu-ip-na-rede>:5173

# Credenciais do único usuário da aplicação (não existe cadastro público).
# Troque a senha padrão caso vá usar em algo além da sua máquina local.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Não precisa definir DATABASE_URL aqui: o docker-compose.yml já aponta o
# backend para o serviço "postgres" (dentro da rede interna do Compose).
# Só é necessário definir manualmente se for rodar `go test ./...` fora do
# Docker, com o Postgres do compose já no ar. Repare que aponta para
# "minikb_test", um banco separado do "minikb" usado pela aplicação:
#   export DATABASE_URL=postgres://minikb:minikb@localhost:5432/minikb_test?sslmode=disable
