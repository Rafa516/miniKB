server {
    # ${PORT} é substituído pelo próprio entrypoint da imagem oficial do
    # Nginx (via envsubst, script padrão em /docker-entrypoint.d/) a
    # partir da variável de ambiente PORT — necessário porque o Railway
    # injeta essa variável e espera que o container escute nela. Localmente
    # (Docker Compose), o padrão continua sendo 80.
    listen ${PORT};
    server_name _;

    # The app is built with base '/miniKB/' (see vite.config.js), so it
    # lives under that sub-path here too; redirect the bare root to it.
    location = / {
        return 302 $scheme://$http_host/miniKB/;
    }

    location /miniKB/ {
        alias /usr/share/nginx/html/miniKB/;
        try_files $uri $uri/ /miniKB/index.html;
    }
}
